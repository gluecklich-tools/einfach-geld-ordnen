{
  "schema_version": 1,
  "updated_utc": "2026-02-03T22:14:21Z",
  "rules": [
    {
      "id": "baseurl_token_no_spaces",
      "description": "Normalize Liquid token to {{site.baseurl}} (no spaces)",
      "pattern": "\\{\\{\\s*site\\.baseurl\\s*\\}\\}",
      "replace": "{{site.baseurl}}",
      "enabled": true
    },
    {
      "id": "baseurl_requires_slash_before_path",
      "description": "Ensure slash after {{site.baseurl}} when followed by seiten/ or pillar/",
      "pattern": "\\{\\{site\\.baseurl\\}\\}(seiten|pillar)\\/",
      "replace": "{{site.baseurl}}/$1/",
      "enabled": true
    }
  ]
}
