# Normalize text files to LF in the repo (recommended for GitHub Pages/Jekyll)
* text=auto eol=lf

# Explicit common text formats
*.md   text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.xml  text eol=lf

# Binary files (never transform)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.ods  binary
*.xlsx binary
