<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}</title>
  <link rel="stylesheet" href="{{ "/assets/main.css" | relative_url }}">
</head>
<body>
  <header class="site-header">
    <div class="container header-row">
      <a class="brand" href="{{ "/" | relative_url }}">Einfach Geld ordnen</a>
      <nav class="nav">
        <a href="{{ "/pillar/" | relative_url }}">Uebersicht</a>
        <a href="{{ "/seiten/start_in_15_minuten.html" | relative_url }}">Start in 15 Minuten</a>
