# .gitignore – einfach-geld-ordnen
# Stand: 2026-01-24
# Ziel: Jekyll/Repo sauber halten + Downloads (ODS/XLSX/ZIP) explizit erlauben
# Zusätzlich: lokale Sicherungen/Private Ablagen sicher vom Commit ausschließen

# --- Jekyll / Ruby ---
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
.bundle/
vendor/
Gemfile.lock

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
*.swp
*.swo

# --- Logs / Temp ---
*.log
*.tmp

# --- Standard: Binär-/Lieferartefakte generell ignorieren ---
*.zip
*.xlsx
*.ods

# --- Ausnahme: Lieferdateien im Ordner "downloads" sollen versioniert werden ---
!/downloads/*.zip
!/downloads/*.xlsx
!/downloads/*.ods

# Optional: falls du mal nur den Ordner ohne Dateien committen willst
!/downloads/.gitkeep

# --- Local-only / Private (niemals committen) ---
_lokal_sicherungen/
_private/
FINANZEN/
ARBEITSANWEISUNG_*.md
BETRIEBSHANDBUCH*.md
MANIFEST*.md

00_workblocks/
# Internal tooling (local only)
tools/
tools/*.ps1
tools/*.psm1
tools/*.txt
tools/*.log
# Local work (never commit)
_local/
_inventur/
_internal/

# local-only governance notes
LEARNINGS.md

# local-only: internal work files
# local-only: learnings (if ever created at repo root)
*.bak_*

qass_v2_*.txt
