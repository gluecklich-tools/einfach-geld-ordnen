# Normalize line endings for the repo (Windows-friendly, CI-stable)
* text=auto

# Enforce LF for common text formats
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.xml  text eol=lf
*.svg  text eol=lf

# Binary files (no line ending conversions)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.ods  binary
*.xlsx binary
*.xlsm binary
