{
  "SiteUrl": "https://gluecklich-tools.github.io/einfach-geld-ordnen",
  "Mode": "sitemap_all",
  "SitemapPath": "/sitemap.xml",
  "MaxUrls": 0,
  "CoreChecks": [
    {
      "Path": "/",
      "Expect": [
        200
      ]
    },
    {
      "Path": "/index.html",
      "Expect": [
        200
      ]
    },
    {
      "Path": "/seiten/downloads.html",
      "Expect": [
        200
      ]
    },
    {
      "Path": "/seiten/rechner-uebersicht.html",
      "Expect": [
        200
      ]
    },
    {
      "Path": "/seiten/datenschutz.html",
      "Expect": [
        200
      ]
    },
    {
      "Path": "/seiten/impressum.html",
      "Expect": [
        200
      ]
    },
    {
      "Path": "/__smoke_not_found__",
      "Expect": [
        404
      ]
    }
  ],
  "IgnorePatterns": []
}