    </div>
  </header>

  <main class="container content">
    {{ content }}
  </main>

  <footer class="site-footer">
    <div class="container footer-row">
      <div class="footer-links">
        <a href="{{ "/seiten/impressum.html" | relative_url }}">Impressum</a>
        <span class="sep">·</span>
        <a href="{{ "/seiten/datenschutz.html" | relative_url }}">Datenschutz</a>
